<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the decision logic (Logic folder), which has no game references. A plain console program, no test
       framework packages, so it also runs where NuGet is not reachable. Run: dotnet run (project tests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Logic/**/*.cs" Link="Logic/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
